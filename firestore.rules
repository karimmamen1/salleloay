rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function activeAdmin() { return signedIn() && profile().data.active == true && (profile().data.role == 'admin' || profile().data.role == 'super_admin'); }
    function superAdmin() { return activeAdmin() && request.auth.token.role == 'super_admin' && profile().data.role == 'super_admin'; }

    function validReservation(data, date) {
      return data.keys().hasAll([
        'reservationDate', 'customerName', 'phone', 'eventType', 'customEventType',
        'guestCount', 'totalCost', 'advancePayment', 'cookName', 'cookCost',
        'serverCount', 'cleaningCost', 'createdByUserId', 'createdByName', 'createdAt',
        'updatedByUserId', 'updatedByName', 'updatedAt'
      ]) && data.keys().hasOnly([
        'reservationDate', 'customerName', 'phone', 'eventType', 'customEventType',
        'guestCount', 'totalCost', 'advancePayment', 'cookName', 'cookCost',
        'serverCount', 'cleaningCost', 'createdByUserId', 'createdByName', 'createdAt',
        'updatedByUserId', 'updatedByName', 'updatedAt'
      ]) && data.reservationDate == date
        && data.customerName is string && data.customerName.size() >= 2 && data.customerName.size() <= 120
        && data.phone is string && data.phone.size() >= 10 && data.phone.size() <= 13
        && data.eventType in ['wedding', 'engagement', 'circumcision', 'birthday', 'reception', 'other']
        && (data.customEventType == null || data.customEventType is string)
        && data.guestCount is int && data.guestCount >= 0
        && data.totalCost is number && data.totalCost >= 0
        && data.advancePayment is number && data.advancePayment >= 0 && data.advancePayment <= data.totalCost
        && data.cookName is string && data.cookName.size() <= 120
        && data.cookCost is number && data.cookCost >= 0
        && data.serverCount is int && data.serverCount >= 0
        && data.cleaningCost is number && data.cleaningCost >= 0
        && data.createdByUserId is string && data.createdByName is string && data.createdAt is timestamp
        && data.updatedByUserId is string && data.updatedByName is string && data.updatedAt is timestamp;
    }

    function validCurrentEditor(data) {
      return data.updatedByUserId == request.auth.uid
        && data.updatedByName == profile().data.name
        && data.updatedAt == request.time;
    }

    function validAudit(data) {
      return data.keys().hasAll(['action', 'performedByUserId', 'performedByName', 'timestamp'])
        && data.keys().hasOnly(['action', 'performedByUserId', 'performedByName', 'reservationId', 'previousReservationId', 'timestamp'])
        && data.action in ['reservation_created', 'reservation_updated', 'reservation_deleted']
        && data.performedByUserId == request.auth.uid
        && data.performedByName == profile().data.name
        && data.timestamp == request.time
        && (data.action != 'reservation_deleted' || superAdmin());
    }

    match /reservations/{date} {
      allow read: if activeAdmin();
      allow create: if activeAdmin() && validReservation(request.resource.data, date)
        && validCurrentEditor(request.resource.data)
        && ((request.resource.data.createdByUserId == request.auth.uid
          && request.resource.data.createdByName == profile().data.name
          && request.resource.data.createdAt == request.time) || superAdmin());
      allow update: if activeAdmin() && validReservation(request.resource.data, date)
        && validCurrentEditor(request.resource.data)
        && request.resource.data.createdByUserId == resource.data.createdByUserId
        && request.resource.data.createdByName == resource.data.createdByName
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if superAdmin();
    }
    match /users/{uid} { allow read: if (signedIn() && request.auth.uid == uid) || superAdmin(); allow write: if false; }
    match /auditLogs/{logId} { allow read: if superAdmin(); allow create: if activeAdmin() && validAudit(request.resource.data); allow update, delete: if false; }
    match /settings/{document} { allow read: if activeAdmin(); allow write: if false; }
    match /usernames/{username} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
